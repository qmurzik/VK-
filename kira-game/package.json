{
  "name": "kira-game",
  "version": "1.0.0",
  "description": "KIRA — 3D-симулятор жизни с Кирой",
  "main": "electron/main.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=game/game.js --minify",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable zip --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "author": "qmurzik",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "three": "^0.169.0"
  },
  "build": {
    "appId": "com.qvk.kira",
    "productName": "KIRA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "game/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "KIRA-${version}-portable.exe"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
