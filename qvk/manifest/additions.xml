<!-- QVK 3.0 components, inserted before </application> by qvk/build.py. -->
<activity android:name="re.sova.qmods.Qvk3WallShare" android:exported="true" android:label="Медиа стены (QVK)"
    android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:noHistory="true">
    <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
    </intent-filter>
</activity>
<activity android:name="re.sova.qmods.Qvk3MusicActivity" android:exported="false" android:label="QVK Music"
    android:launchMode="singleTop"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
    android:windowSoftInputMode="adjustResize" />
<service android:name="re.sova.qmods.Qvk3MusicService" android:exported="false"
    android:foregroundServiceType="mediaPlayback" />
<activity android:name="re.sova.qmods.Qvk3SettingsActivity" android:exported="false" android:label="Настройки QVK"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
    android:windowSoftInputMode="adjustResize" />
<receiver android:name="re.sova.qmods.Qvk3UpdateReceiver" android:exported="false" />
<provider android:name="re.sova.qmods.Qvk3Runtime" android:authorities="ru.qmods.qvk.qvk3runtime"
    android:exported="false" android:initOrder="-100" />
<activity android:name="re.sova.qmods.Qvk3StylesActivity" android:exported="false" android:label="Оформление"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
<activity android:name="re.sova.qmods.Qvk3ShellActivity" android:exported="false" android:label="QVK"
    android:launchMode="singleTop" android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
    android:windowSoftInputMode="adjustResize" />
<activity android:name="re.sova.qmods.Qvk3ChatActivity" android:exported="false" android:label="Чат"
