ing.vk_permissions_camera_qr_local":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –¥–æ—Å—Ç—É–ø –∫ –ø–∞–º—è—Ç–∏ —É—Å—Ç—Ä–æ–π—Å—Ç–≤–∞, —á—Ç–æ–±—ã —Å–∫–∞–Ω–∏—Ä–æ–≤–∞—Ç—å QR-–∫–æ–¥—ã","string.vk_permissions_camera_qr_settings":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –≤ –Ω–∞—Å—Ç—Ä–æ–π–∫–∞—Ö –¥–æ—Å—Ç—É–ø –∫ –∫–∞–º–µ—Ä–µ —É—Å—Ç—Ä–æ–π—Å—Ç–≤–∞","string.vk_permissions_camera_video_msg":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –¥–æ—Å—Ç—É–ø –∫¬†–∫–∞–º–µ—Ä–µ, –ø–∞–º—è—Ç–∏ –∏¬†–º–∏–∫—Ä–æ—Ñ–æ–Ω—É, —á—Ç–æ–±—ã —Å–Ω–∏–º–∞—Ç—å –≤–∏–¥–µ–æ—Å–æ–æ–±—â–µ–Ω–∏—è","string.vk_permissions_camera_vmoji":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –¥–æ—Å—Ç—É–ø –∫ –∫–∞–º–µ—Ä–µ, —á—Ç–æ–±—ã —Å–æ–∑–¥–∞—Ç—å –ø–µ—Ä—Å–æ–Ω–∞–∂–∞","string.vk_permissions_camera_vmoji_settings":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –≤ –Ω–∞—Å—Ç—Ä–æ–π–∫–∞—Ö –¥–æ—Å—Ç—É–ø –∫¬†–∫–∞–º–µ—Ä–µ —É—Å—Ç—Ä–æ–π—Å—Ç–≤–∞","string.vk_permissions_cancel":"–û—Ç–∫–ª–æ–Ω–∏—Ç—å","string.vk_permissions_contacts":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –¥–æ—Å—Ç—É–ø, —á—Ç–æ–±—ã –∏—Å–∫–∞—Ç—å –¥—Ä—É–∑–µ–π –≤ —Å–ø–∏—Å–∫–µ –≤–∞—à–∏—Ö –∫–æ–Ω—Ç–∞–∫—Ç–æ–≤ –∏ –ø–æ–ª—É—á–∞—Ç—å –∞–∫—Ç—É–∞–ª—å–Ω—ã–µ —Ä–µ–∫–æ–º–µ–Ω–¥–∞—Ü–∏–∏ –¥—Ä—É–∑–µ–π","string.vk_permissions_contacts_edu_sync_auto":"–ë—É–¥–µ—Ç –ø—Ä–æ—â–µ –Ω–∞–π—Ç–∏ –∑–Ω–∞–∫–æ–º—ã—Ö, –∫–æ—Ç–æ—Ä—ã–µ —Ç–æ–∂–µ –µ—Å—Ç—å –≤¬†–°—Ñ–µ—Ä—É–º–µ. –í—Å–µ –ª–∏—á–Ω—ã–µ –¥–∞–Ω–Ω—ã–µ —Ö—Ä–∞–Ω—è—Ç—Å—è –≤¬†–∑–∞—à–∏—Ñ—Ä–æ–≤–∞–Ω–Ω–æ–º –≤–∏–¥–µ –Ω–∞¬†—Å–µ—Ä–≤–µ—Ä–∞—Ö —Å–µ—Ä–≤–∏—Å–∞.","string.vk_permissions_contacts_edu_title":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –¥–æ—Å—Ç—É–ø –∫¬†–∫–æ–Ω—Ç–∞–∫—Ç–∞–º","string.vk_permissions_contacts_sync":"–†–∞–∑—Ä–µ—à–∏—Ç–µ –¥–æ—Å—Ç—É–ø –∫ –∫–æ–Ω—Ç–∞–∫—Ç–∞–º, —á—Ç–æ–±—ã –¥–æ–±–∞–≤–∏—Ç—å –≤–∞—à–∏—Ö –¥—Ä—É–∑–µ–π –í–ö–æ–Ω—Ç–∞–∫—Ç–µ –≤ —Ç–µ–ª–µ—Ñ–æ–Ω–Ω—É—é –∫–Ω–∏–≥—É","string.vk_permissions_contacts_sync_auto":"–í—ã —Å–º–æ–∂–µ—Ç–µ –ø—Ä–æ—Å–º–∞—Ç—Ä–∏–≤–∞—Ç—å, –∫—Ç–æ –∏–∑¬†–∫–æ–Ω—Ç–∞–∫—Ç–æ–≤ –Ω–∞¬†—É—Å—Ç—Ä–æ–π—Å—Ç–≤–µ –µ—Å—Ç—å –í–ö–æ–Ω—Ç–∞–∫—Ç–µ, –∏¬†–¥–æ–±–∞–≤–ª—è—Ç—å –∏—Ö –≤¬†–¥—Ä—É–∑—å—è. –í—Å–µ –ª–∏—á–Ω—ã–µ –¥–∞–Ω–Ω—ã–µ —Ö—Ä–∞–Ω—è—Ç—Å—è –≤¬†–∑–∞—à–∏—Ñ—Ä–æ–≤–∞–Ω–Ω–æ–º –≤–∏–¥–µ –Ω–∞¬†—Å–µ—Ä–≤–µ—Ä–∞—Ö –í–ö–æ–Ω—Ç–∞–∫—Ç–µ.","string.vk_permissions_